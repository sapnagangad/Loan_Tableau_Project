      <aliases enabled='yes' />
      <column caption='Annual Income' datatype='integer' name='[Annual_Income]' role='measure' type='quantitative' />
      <column caption='Loan Approval Flag' datatype='integer' name='[Calculation_1071777867681792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Loan_Status] = &quot;Approved&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Rejected Flag' datatype='integer' name='[Calculation_1071777868300289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Loan_Status] = &quot;Rejected&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Income Group' datatype='string' name='[Calculation_1071777868808195]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Annual_Income] &lt; 500000 THEN &quot;Low Income&quot;&#13;&#10;ELSEIF [Annual_Income] &lt; 1000000 THEN &quot;Middle Income&quot;&#13;&#10;ELSE &quot;High Income&quot;&#13;&#10;END' />
      </column>
      <column caption='Dynamic Measure' datatype='real' name='[Calculation_1071777872941060]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Loan Amount&quot; THEN [Loan_Amount]&#13;&#10;WHEN &quot;Annual Income&quot; THEN [Annual_Income]&#13;&#10;WHEN &quot;Credit Score&quot; THEN [Credit_Score]&#13;&#10;WHEN &quot;Interest Rate&quot; THEN [Interest_Rate]&#13;&#10;END' />
      </column>
      <column caption='Credit Risk Segment' datatype='string' name='[Calculation_1071777878130693]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Credit_Score]) THEN &quot;Unknown&quot;&#13;&#10;ELSEIF [Credit_Score] &gt;= [Parameters].[Parameter 2] THEN &quot;Good Credit&quot;&#13;&#10;ELSE &quot;Low Credit&quot;&#13;&#10;END' />
      </column>
      <column caption='Age Segment' datatype='string' name='[Calculation_1071777881309190]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Customer_Age] &lt;= [Parameters].[Parameter 3] THEN &quot;Below Selected Age&quot;&#13;&#10;ELSE &quot;Above Selected Age&quot;&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Credit Score' datatype='integer' name='[Credit_Score]' role='dimension' type='ordinal' />
      <column caption='Customer Age' datatype='integer' name='[Customer_Age]' role='measure' type='quantitative' />
      <column caption='Employment Status' datatype='string' name='[Employment_Status]' role='dimension' type='nominal' />
      <column caption='Interest Rate' datatype='real' name='[Interest_Rate]' role='measure' type='quantitative' />
      <column aggregation='Sum' caption='Loan Amount' datatype='integer' name='[Loan_Amount]' role='dimension' type='ordinal' />
